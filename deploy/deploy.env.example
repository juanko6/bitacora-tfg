# Copia este fichero a deploy/deploy.env (no se versiona) y pon tus valores.
# Lo leen deploy/setup-server.sh, deploy/publish.sh, deploy/backup.sh y
# deploy/import.sh.

# Servidor: un alias de ~/.ssh/config o usuario@ip. El usuario necesita sudo
# para la instalación inicial; para publicar basta con que pueda escribir en
# DEPLOY_PATH.
DEPLOY_HOST=mi-servidor

# Dominio en el que se publica. Debe tener un registro A apuntando al servidor
# antes de pedir el certificado.
DEPLOY_DOMAIN=bitacora.ejemplo.com

# Carpeta del servidor donde va el sitio estático.
DEPLOY_PATH=/var/www/bitacora

# 1 = instala la API (server/api.py) y los datos se guardan en el servidor.
# 0 = sitio solo estático: cada visitante guarda sus datos en su navegador.
DEPLOY_API=1

# Con la API: 1 = cualquiera puede leer la bitácora, solo tú la editas.
#             0 = también hace falta la clave para leerla.
DEPLOY_PUBLIC_READ=1

# Puerto local de la API en el servidor. Cámbialo si el 8787 está ocupado.
DEPLOY_API_PORT=8787

# Correo para Let's Encrypt (avisos de caducidad). Vacío si el servidor ya
# tiene una cuenta de certbot registrada.
DEPLOY_EMAIL=
